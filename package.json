{
  "name": "boyo-python-studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-static.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "format": "prettier --write src scripts tests index.html package.json tsconfig.json vite.config.ts playwright.config.ts README.md THIRD_PARTY_NOTICES.md docs .github/workflows/ci.yml",
    "format:check": "prettier --check src scripts tests index.html package.json tsconfig.json vite.config.ts playwright.config.ts README.md THIRD_PARTY_NOTICES.md docs .github/workflows/ci.yml",
    "postinstall": "node scripts/prepare-vendor.mjs",
    "predev": "node scripts/prepare-vendor.mjs",
    "prebuild": "node scripts/prepare-vendor.mjs",
    "test:toolbox": "node scripts/check-toolboxes.mjs"
  },
  "dependencies": {
    "@blockly/field-multilineinput": "13.4.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@xmldom/xmldom": "0.9.12",
    "blockly": "13.4.0",
    "localforage": "1.10.0",
    "lucide-react": "1.61.0",
    "peerjs": "1.5.5",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1",
    "npm": ">=11.20.0"
  },
  "packageManager": "npm@11.20.0"
}
